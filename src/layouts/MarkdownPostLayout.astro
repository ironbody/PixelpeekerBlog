---
import TagsList from "@components/TagsList.astro";
import type { blogType } from "@content/schemas";
import { format } from "date-fns";

import Layout from "./Layout.astro";

interface Props {
  frontmatter: blogType;
  minutesRead: string;
}
const { frontmatter, minutesRead } = Astro.props;
const { title, pubDate, author, image, tags } = frontmatter;
const formattedPubDate = format(pubDate, "MMM dd, yyyy");
---

<Layout title={title}>
  <article>
    <h1>{title}</h1>
    {image && <img src={image.url} width="300" alt={image.alt} />}
    <div class="not-prose">
      <p>
        <b>{author}</b>
      </p>
      <div class="flex flex-wrap items-center gap-x-4 text-base-content/80">
        <p>{formattedPubDate}</p>
        <p>{minutesRead}</p>
        <TagsList tags={tags} />
      </div>
    </div>
    <div class="divider"></div>

    <slot />
  </article>
</Layout>
