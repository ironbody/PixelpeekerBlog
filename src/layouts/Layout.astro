---
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import {
  THEME_STORAGE_KEY,
  themeColors,
  themes,
} from "@components/ToggleTheme";
import Analytics from "@vercel/analytics/astro";
import "@fontsource/young-serif";

import "@fontsource/atkinson-hyperlegible/400.css";
import "@fontsource/atkinson-hyperlegible/400-italic.css";
import "@fontsource/atkinson-hyperlegible/700.css";
import "@fontsource/atkinson-hyperlegible/700-italic.css";
import "@fontsource/space-mono/400.css";
import "../styles/global.css";

interface Props {
  title: string;
}

// prose-code:bg-neutral prose-code:text-neutral-content prose-code:rounded-md

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="theme-color"
      content={themeColors.light}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={themeColors.dark}
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" href="/assets/favicon.ico" />
    <link rel="me" href="https://tech.lgbt/@ironbody" />
    <title>{`${title} · pixelpeeker`}</title>
    <Analytics />
    <script is:inline define:vars={{ THEME_STORAGE_KEY, themes, themeColors }}>
      const selected = localStorage.getItem(THEME_STORAGE_KEY) ?? "";

      if (selected == "light" || selected == "dark") {
        document.documentElement.dataset.theme = themes[selected];
        document
          .querySelectorAll('meta[name="theme-color"]')
          .forEach((meta) => (meta.content = themeColors[selected]));
      }
    </script>
  </head>
  <body class="font-body">
    <div class="flex min-h-dvh flex-col">
      <Header />
      <main
        class="mx-auto prose prose-lg w-full flex-1 px-5 pt-8
          pb-16 text-base-content md:pt-12 prose-headings:font-display
          prose-headings:font-normal prose-h1:mb-4
          prose-h1:text-4xl prose-h1:leading-tight md:prose-h1:text-5xl
          prose-h2:text-2xl md:prose-h2:text-3xl prose-a:text-primary"
      >
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
