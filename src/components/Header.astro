---
import Navigation from "./Navigation.astro";
import ToggleTheme from "./ToggleTheme.tsx";
---

<header class="bg-base-200">
  <nav
    class="mx-auto grid min-h-16 max-w-4xl grid-cols-[1fr_auto] items-center
          px-2 font-space-mono md:grid-cols-[1fr_auto_1fr] md:px-4"
  >
    <section class="flex items-center">
      <ToggleTheme client:only="react">
        <span slot="fallback" class="btn btn-square btn-ghost"></span>
      </ToggleTheme>
      <a
        href="/"
        class="px-2 font-space-mono text-base font-normal normal-case md:text-lg"
      >
        $pixelpeeker
      </a>
    </section>
    <section>
      <ul class="flex text-sm md:gap-2 md:text-base">
        <Navigation />
      </ul>
    </section>
  </nav>
</header>
